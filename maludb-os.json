{
  "schema": "maludb-os.application/1",
  "catalog_key": "consultant_tracking",
  "name": "Consultant Tracking",
  "description": "Professional services for a technical or AI consultancy: clients and engagements (time-and-materials with expenses, or fixed bid against milestones), weekly timesheets with a timer, expenses with receipts snapped on a phone, hosting and model-usage pass-through — by hand, from a provider's usage export, from a hosting schedule, or allocated from the kernel's monthly AI statement by rules —, invoices by email and a secure link with their backing detail, and the firm's reports: unbilled work, utilization, realization, budget burn, margin, AI cost vs. billed. It bills and never keeps the books: the accounting system reads it through the kernel.",
  "business_area": "Sales & Service",
  "category": "other",
  "icon": "feather-briefcase",
  "version": "0.1.0",
  "criticality": "high",
  "vhost": {
    "label": "consulting",
    "document_root": "html",
    "internal_port_env": "APP_INTERNAL_PORT"
  },
  "database": {
    "suffix": "consultant_tracking",
    "migrations": "db",
    "roles": {
      "rw": "consultant_tracking_rw",
      "records_ro": "consultant_tracking_records_ro",
      "activity_ro": "consultant_tracking_activity_ro"
    }
  },
  "env": {
    "required": [
      "APP_NAME",
      "APP_URL",
      "DB_HOST",
      "DB_PORT",
      "DB_NAME",
      "DB_USER",
      "DB_PASSWORD",
      "MCP_RECORDS_DB_USER",
      "MCP_RECORDS_DB_PASSWORD",
      "MCP_ACTIVITY_DB_USER",
      "MCP_ACTIVITY_DB_PASSWORD",
      "APP_INTERNAL_PORT",
      "MCP_RECORDS_PORT",
      "MCP_ACTIVITY_PORT",
      "ACTION_TOKEN_KEY",
      "ACTIONS_RELAY_KEY",
      "OS_APPLICATION_TOKEN",
      "OS_INTERNAL_URL",
      "OS_LAUNCHER_URL",
      "APP_KEY",
      "MALUDB_API_URL",
      "MALUDB_API_TOKEN"
    ],
    "optional": [
      "MALUMAIL_API_KEY",
      "MALUMAIL_API_URL",
      "MAIL_FROM",
      "MAIL_FROM_NAME",
      "ATTACHMENT_MAX_BYTES",
      "CT_LINK_LIFETIME_DAYS",
      "API_CORS_ORIGINS"
    ]
  },
  "services": [
    "deploy/consultant_tracking-records-mcp.service",
    "deploy/consultant_tracking-activity-mcp.service",
    "deploy/consultant_tracking-activity-ingest.service",
    "deploy/consultant_tracking-activity-ingest.timer",
    "deploy/consultant_tracking-directory-sync.service",
    "deploy/consultant_tracking-directory-sync.timer",
    "deploy/consultant_tracking-worker.service",
    "deploy/consultant_tracking-worker.timer"
  ],
  "endpoints": [
    {
      "name": "Web UI",
      "kind": "ui",
      "path": "/",
      "auth_kind": "none",
      "agent_reachable": false
    },
    {
      "name": "Health",
      "kind": "http_api",
      "path": "/api/v1/health",
      "auth_kind": "none",
      "agent_reachable": false
    }
  ],
  "actions": {
    "manifest": "docs/consultant-tracking-action-manifest.md",
    "registry": "mcp/action_registry.json",
    "base_url_env": "APP_INTERNAL_PORT"
  },
  "skills": [
    "skills/consulting-basics",
    "skills/rates-and-billing-rules",
    "skills/writing-to-clients",
    "skills/monday-missing-time",
    "skills/draft-the-period-invoices",
    "skills/allocate-the-ai-statement",
    "skills/budget-review"
  ],
  "sso": {
    "path": "/sso",
    "logout_path": "/sso/logout"
  },
  "directory": {
    "reads": true,
    "writes": false
  },
  "assistant": {
    "command_bar": true,
    "agent": "expert"
  },
  "shares": [
    {
      "tool": "invoices_issued",
      "description": "Invoices issued in a period, lines summarised by kind (time, expense, usage, milestone, fixed, adjustment) — for the ledger's source import (os.ct-invoices/1)",
      "scoped": false
    },
    {
      "tool": "credit_notes_issued",
      "description": "Credit notes issued in a period, the same shape, negative (os.ct-credit-notes/1)",
      "scoped": false
    },
    {
      "tool": "expenses_by_category",
      "description": "Approved company-card expenses by category and month, no person named (os.ct-expenses/1)",
      "scoped": false
    },
    {
      "tool": "unbilled_summary",
      "description": "Approved, unbilled work at bill value per engagement as of a date — the WIP accrual (os.ct-wip/1)",
      "scoped": false
    },
    {
      "tool": "reimbursements_approved",
      "description": "Approved, unreimbursed personal-card expenses per member — for HR to pay in a pay run (os.ct-reimbursements/1)",
      "scoped": false,
      "people": true
    },
    {
      "tool": "engagement_list",
      "description": "Active engagements: number, name, client short name, kind, dates; no money (os.ct-engagements/1)",
      "scoped": false
    }
  ],
  "reads": [
    {
      "app": "gl",
      "tool": "invoice_receipts",
      "why": "Mark our invoices paid from the ledger's receipts, by our invoice number (G1 — owed by General Ledger)"
    }
  ],
  "agents": [
